# application-local.properties.example
# Copiază acest fișier ca 'application-local.properties' și completează valorile tale locale.
# NU comite 'application-local.properties' în git (adăugat în .gitignore).
#
# Pornire cu profil local:
#   mvn spring-boot:run -Dspring-boot.run.profiles=local
#   sau setează env var: SPRING_PROFILES_ACTIVE=local

spring.docker.compose.enabled=false

spring.datasource.url=jdbc:postgresql://localhost:5432/akadion
spring.datasource.username=myuser
spring.datasource.password=INLOCUIESTE_CU_PAROLA_DB

spring.security.oauth2.client.registration.keycloak.client-secret=INLOCUIESTE_CU_SECRET_BACKEND_LOGIN
spring.security.oauth2.client.registration.keycloak-register.client-secret=INLOCUIESTE_CU_SECRET_BACKEND_LOGIN
spring.security.oauth2.client.registration.keycloak-admin.client-secret=INLOCUIESTE_CU_SECRET_BACKEND_ADMIN_API
spring.security.oauth2.client.provider.keycloak.issuer-uri=http://localhost:8080/realms/akadion

app.keycloak.realm=akadion
app.keycloak.base-url=http://localhost:8080
app.frontend.base-url=http://localhost:5173
