DB_PASSWORD=SET_LOCAL_DB_PASSWORD
MINIO_ROOT_USER=SET_LOCAL_MINIO_USER
MINIO_ROOT_PASSWORD=SET_LOCAL_MINIO_PASSWORD
KEYCLOAK_BACKEND_LOGIN_SECRET=SET_LOCAL_KEYCLOAK_LOGIN_SECRET
KEYCLOAK_ADMIN_API_SECRET=SET_LOCAL_KEYCLOAK_ADMIN_SECRET
RAG_SERVICE_USERNAME=SET_LOCAL_RAG_USERNAME
RAG_SERVICE_PASSWORD=SET_LOCAL_RAG_PASSWORD
RAG_BASE_URL=http://llm-response:8000
RAG_EMBEDDER_URL=http://embedder:8001
# Callback embedder -> Spring Boot (PATCH /api/rag/documents/image-status) la finalul
# job-ului async de imagini. Trebuie sa fie identic si in rag/embedder/.env
# (SPRING_BOOT_CALLBACK_USERNAME/PASSWORD), altfel Basic Auth pica.
SPRING_BOOT_CALLBACK_USERNAME=SET_LOCAL_CALLBACK_USERNAME
SPRING_BOOT_CALLBACK_PASSWORD=SET_LOCAL_CALLBACK_PASSWORD
